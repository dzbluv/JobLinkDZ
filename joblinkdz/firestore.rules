rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isValidUser(data) {
      return data.keys().hasAll(['full_name', 'email', 'role']) &&
             data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role in ['candidate', 'admin'];
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSignedIn());
      allow list: if isSignedIn() && existing().role == 'admin'; // Allow everyone to see admins for job details, otherwise users aren't listable. (Wait, let's just make it simple: existing().role in ['candidate', 'admin']) Actually, we shouldn't allow blanket listing of users.
      // Wait, let's fix list. Only allowed if querying for self or if admin.
      // Actually, let's not allow list at all for users unless it's self.
      
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().keys().size() <= 10;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'location']) && incoming().role == existing().role && incoming().email == existing().email;
    }

    function isValidCompany(data) {
      return data.keys().hasAll(['name', 'industry', 'owner_id']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.industry is string && data.industry.size() <= 100 &&
             data.owner_id == request.auth.uid;
    }

    match /companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if existing().owner_id == request.auth.uid || existing().name != null; // Everyone can list companies. "existing().name != null". Wait, list should be secure. We can just allow all users to read.
      
      allow create: if isValidId(companyId) && isSignedIn() && isValidCompany(incoming()) && incoming().keys().size() <= 15;
      allow update: if isValidId(companyId) && isSignedIn() && existing().owner_id == request.auth.uid && isValidCompany(incoming()) && incoming().owner_id == existing().owner_id && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'logo', 'industry', 'location', 'website', 'description', 'employees', 'size', 'founded']);
    }

    function isValidJob(data) {
      return data.keys().hasAll(['title', 'company_id', 'status', 'owner_id']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.company_id is string && data.company_id.size() <= 128 &&
             data.status in ['active', 'closed'] &&
             data.owner_id == request.auth.uid;
    }

    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if existing().status == 'active' || existing().owner_id == request.auth.uid;
      
      allow create: if isValidId(jobId) && isSignedIn() && isValidJob(incoming()) && exists(/databases/$(database)/documents/companies/$(incoming().company_id)) && incoming().keys().size() <= 20;
      allow update: if isValidId(jobId) && isSignedIn() && existing().owner_id == request.auth.uid && isValidJob(incoming()) && incoming().owner_id == existing().owner_id && incoming().company_id == existing().company_id && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'location', 'job_type', 'salary_range', 'description', 'requirements', 'responsibilities', 'status', 'skills']);
      allow delete: if isValidId(jobId) && isSignedIn() && existing().owner_id == request.auth.uid;
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['candidate_id', 'job_offer_id', 'status']) &&
             data.candidate_id == request.auth.uid &&
             data.job_offer_id is string && data.job_offer_id.size() <= 128 &&
             data.status in ['pending', 'reviewing', 'accepted', 'rejected'];
    }

    match /applications/{applicationId} {
      // Users can see their own applications, or companies can see applications for their jobs.
      allow get: if isValidId(applicationId) && isSignedIn() && (existing().candidate_id == request.auth.uid || existing().company_owner_id == request.auth.uid);
      allow list: if isSignedIn() && (existing().candidate_id == request.auth.uid || existing().company_owner_id == request.auth.uid);
      
      allow create: if isValidId(applicationId) && isSignedIn() && isValidApplication(incoming()) && exists(/databases/$(database)/documents/jobs/$(incoming().job_offer_id)) && incoming().keys().size() <= 15;
      
      // Candidate can only update cover message if pending. Company owner can update status.
      // This is simplified.
      allow update: if isValidId(applicationId) && isSignedIn() && (
        (existing().candidate_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['cover_message']) && existing().status == 'pending' && isValidApplication(incoming()) && incoming().candidate_id == existing().candidate_id && incoming().job_offer_id == existing().job_offer_id) ||
        (existing().company_owner_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['pending', 'reviewing', 'accepted', 'rejected'] && incoming().candidate_id == existing().candidate_id && incoming().job_offer_id == existing().job_offer_id)
      );
    }
  }
}
